{
  "name": "Simplified to Traditional (Hong Kong variant, text dicts)",
  "normalization": [ { "dict": { "type": "text", "file": "CJK_Compatibility_Ideographs.txt" } } ],
  "segmentation": { "type": "mmseg", "dict": { "type": "text", "file": "STPhrases.txt" } },
  "conversion_chain": [
    { "dict": { "type": "group", "match_policy": "short_circuit", "dicts": [
        { "type": "text", "file": "STPhrases.txt" },
        { "type": "text", "file": "STCharacters.txt" }
    ] } },
    { "dict": { "type": "group", "match_policy": "short_circuit", "dicts": [
        { "type": "text", "file": "HKVariantsPhrases.txt" },
        { "type": "text", "file": "HKVariants.txt" }
    ] } }
  ]
}
